{
  "name": "mini-program-ux-pro",
  "version": "1.0.0",
  "private": false,
  "description": "微信小程序审美与交互设计智能 Skill：本地设计知识检索、设计系统生成、静态审查与验证工作流。",
  "license": "MIT",
  "scripts": {
    "mpux": "python mpux.py",
    "doctor": "python mpux.py doctor",
    "search": "python mpux.py search",
    "design-system": "python mpux.py design",
    "audit": "python mpux.py audit",
    "compare": "python mpux.py compare",
    "validate:data": "python scripts/validate_data.py",
    "validate:skill": "python scripts/validate_skill.py",
    "validate": "python scripts/validate_project.py --path .",
    "test": "python -m unittest discover -s tests -v",
    "install:project": "python mpux.py install --project",
    "verify:runtime": "python mpux.py verify run --project verification"
  },
  "keywords": [
    "wechat",
    "mini-program",
    "mini-program-ux",
    "ui",
    "ux",
    "design-system",
    "ai-skill",
    "wechat-native",
    "uni-app",
    "taro"
  ],
  "author": "Mini Program UX Pro Contributors",
  "python": ">=3.10",

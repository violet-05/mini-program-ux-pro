{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mpux-pro/schemas/review-comparison.schema.json",
  "title": "MPUX Pro Static Review Comparison",
  "description": "review_compare.py 的两份静态审查报告对比结构；修复只在可确认时计入 resolved。",
  "type": "object",
  "required": ["schema_version", "report_type", "generator", "before", "after", "warnings", "scope", "summary", "new", "new_unverified", "resolved", "unconfirmed", "remaining", "note"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_type": {"const": "static-review-comparison"},
    "generator": {
      "type": "object", "required": ["name", "version"],
      "properties": {"name": {"const": "mini-program-ux-pro"}, "version": {"$ref": "#/$defs/text"}}
    },
    "before": {"$ref": "#/$defs/side"},
    "after": {"$ref": "#/$defs/side"},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["files_added", "files_removed"],
      "properties": {"files_added": {"$ref": "#/$defs/count"}, "files_removed": {"$ref": "#/$defs/count"}}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["new", "new_unverified", "resolved", "unconfirmed", "remaining", "new_by_severity"],
      "properties": {
        "new": {"$ref": "#/$defs/count"}, "new_unverified": {"$ref": "#/$defs/count"},
        "resolved": {"$ref": "#/$defs/count"}, "unconfirmed": {"$ref": "#/$defs/count"},
        "remaining": {"$ref": "#/$defs/count"},
        "new_by_severity": {
          "type": "object", "additionalProperties": false, "required": ["P0", "P1", "P2", "P3"],
          "properties": {"P0": {"$ref": "#/$defs/count"}, "P1": {"$ref": "#/$defs/count"}, "P2": {"$ref": "#/$defs/count"}, "P3": {"$ref": "#/$defs/count"}}
        }
      }
    },
    "new": {"$ref": "#/$defs/entries"},
    "new_unverified": {"$ref": "#/$defs/entries"},
    "resolved": {"$ref": "#/$defs/entries"},
    "unconfirmed": {"$ref": "#/$defs/entries"},
    "remaining": {"$ref": "#/$defs/entries"},
    "note": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "count": {"type": "integer", "minimum": 0},
    "side": {
      "type": "object", "required": ["path", "generated_at", "files_scanned", "findings"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "generated_at": {"$ref": "#/$defs/text"},
        "files_scanned": {"$ref": "#/$defs/count"}, "findings": {"$ref": "#/$defs/count"}
      }
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "entry": {
      "type": "object",
      "required": ["id", "fingerprint", "check_id", "side", "severity", "category", "title", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "check_id": {"$ref": "#/$defs/text"},
        "side": {"enum": ["before", "after"]},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "previous_severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "category": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"},
        "recommendation": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["file", "line"],
            "properties": {"file": {"$ref": "#/$defs/text"}, "line": {"type": "integer", "minimum": 1}}
          }
        }
      }
    }
  }
}

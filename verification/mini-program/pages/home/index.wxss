.home-page {
  padding-top: 24rpx;
}

.hero {
  padding: 16rpx 0 8rpx;
}

.hero .display {
  max-width: 620rpx;
}

.hero-sub {
  display: block;
  max-width: 600rpx;
  margin-top: 20rpx;
  color: #B2B6BE;
  color: var(--mpux-color-text-secondary, #B2B6BE);
  font-size: 28rpx;
  line-height: 1.7;
}

.continue-card {
  display: flex;
  gap: 28rpx;
  margin-top: 44rpx;
  padding: 28rpx;
}

.cover-night {
  position: relative;
  flex: 0 0 220rpx;
  width: 220rpx;
  height: 220rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: linear-gradient(145deg, #252919 0%, #0D0F12 42%, #2C3037 100%);
}

.cover-glow {
  position: absolute;
  top: 46rpx;
  left: 58rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #D7E94C;
  opacity: 0.88;
}

.cover-orbit {
  position: absolute;
  border: 1rpx solid rgba(245, 241, 232, 0.34);
  border-radius: 50%;
}

.orbit-one {
  top: 20rpx;
  left: 28rpx;
  width: 164rpx;
  height: 164rpx;
}

.orbit-two {
  top: 4rpx;
  left: 12rpx;
  width: 196rpx;
  height: 196rpx;
  opacity: 0.55;
}

.cover-label {
  position: absolute;
  left: 18rpx;
  bottom: 16rpx;
  color: rgba(245, 241, 232, 0.76);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  white-space: nowrap;
}

.continue-copy {
  flex: 1;
  min-width: 0;
  padding: 2rpx 0;
}

.track-name {
  display: block;
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.25;
}

.progress-track {
  width: 100%;
  height: 4rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #2C3037;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #D7E94C;
  background: var(--mpux-color-brand, #D7E94C);
}

.progress-meta {
  display: block;
  margin-top: 10rpx;
  color: #B2B6BE;
  color: var(--mpux-color-text-secondary, #B2B6BE);
  font-size: 24rpx;
  line-height: 1.4;
}

.open-player {
  margin-top: 20rpx;
}

.track-list {
  overflow: hidden;
  border-top: 1rpx solid #2C3037;
  border-color: var(--mpux-color-border, #2C3037);
}

.track-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 112rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #2C3037;
  border-color: var(--mpux-color-border, #2C3037);
  text-align: left;
}

.track-index {
  flex: 0 0 54rpx;
  color: #D7E94C;
  color: var(--mpux-color-brand, #D7E94C);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.track-copy {
  flex: 1;
  min-width: 0;
}

.track-title {
  display: block;
  overflow: hidden;
  color: #F5F1E8;
  color: var(--mpux-color-text-primary, #F5F1E8);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.track-sub {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #B2B6BE;
  color: var(--mpux-color-text-secondary, #B2B6BE);
  font-size: 24rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.track-duration {
  flex: 0 0 auto;
  margin-left: 20rpx;
  color: #B2B6BE;
  color: var(--mpux-color-text-secondary, #B2B6BE);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.state-panel {
  margin-top: 48rpx;
  padding: 44rpx 32rpx;
  text-align: left;
}

.state-kicker {
  display: block;
  color: #D7E94C;
  color: var(--mpux-color-brand, #D7E94C);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.state-title {
  display: block;
  margin: 12rpx 0 16rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.retry-button,
.reset-button {
  margin-top: 32rpx;
}

@media (max-width: 340px) {
  .continue-card {
    flex-direction: column;
  }

  .cover-night {
    width: 100%;
    height: 280rpx;
    flex-basis: auto;
  }
}